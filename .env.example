# Copy to .env (project root or backend/). Everything here is optional:
# with no project set, the game runs on its offline mock voices.

# Gemini on Vertex AI, same setup as the CS639 reference project: your
# Google Cloud project ID, signed in once with
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite

# auto (Gemini if a project is set, else mock) | mock | gemini
LLM_MODE=auto

CORS_ORIGINS=http://localhost:5173
